{
  "_comment": "Copy the settings below into your project's .vscode/settings.json. Remove any you don't need.",

  // ── Core model ──────────────────────────────────────────────────────────────
  "ollamaForge.serverUrl": "http://localhost:11434",
  "ollamaForge.model": "qwen2.5-coder:7b",
  "ollamaForge.temperature": 0.7,

  // ── Multi-model routing ─────────────────────────────────────────────────────
  // fastModel handles read-only turns (shell_read, memory_search) — much cheaper.
  // criticModel reviews each edit before the agent sees the result.
  // Set routing.enabled to true to activate. Remove or set to "" to disable routing.
  "ollamaForge.routing.enabled": false,
  "ollamaForge.routing.fastModel": "qwen2.5-coder:1.5b",
  "ollamaForge.routing.criticModel": "",

  // ── Memory ─────────────────────────────────────────────────────────────────
  "ollamaForge.memory.enabled": true,
  "ollamaForge.memory.autoSave": false,
  // Qdrant vector DB for semantic memory search (Tiers 4-5).
  // Leave blank to use local-only memory (Tiers 0-3 still work).
  "ollamaForge.memory.qdrantUrl": "",
  "ollamaForge.memory.embeddingModel": "nomic-embed-text",
  "ollamaForge.memory.embeddingUrl": "",

  // ── Image generation ────────────────────────────────────────────────────────
  // Point the agent at a ComfyUI instance to enable the generate_image tool.
  // ComfyUI must be running with SDXL Base (sd_xl_base_1.0.safetensors) loaded.
  // Binds to 0.0.0.0 by default so it's reachable over the network.
  //
  // Leave empty to disable image generation.
  "ollamaForge.comfyui.url": "http://localhost:8188",

  // ── Web search ──────────────────────────────────────────────────────────────
  // Point the agent at a SearXNG instance to enable web_search and web_fetch.
  // SearXNG is a free, self-hosted meta-search engine — no API key required.
  //
  // Quickstart (Docker):
  //   docker run -d --name searxng -p 8888:8080 \
  //     -e SEARXNG_SECRET=$(openssl rand -hex 32) \
  //     searxng/searxng:latest
  //
  // Then set the URL below to http://<your-host>:8888
  // The agent appends /search?q={query}&format=json automatically.
  //
  // Leave empty to keep the agent fully offline.
  "ollamaForge.search.url": "http://localhost:8888",
  "ollamaForge.search.resultsLimit": 5,

  // ── Context & turns ─────────────────────────────────────────────────────────
  "ollamaForge.autoCompactContext": true,
  "ollamaForge.maxTurnsPerSession": 0,

  // ── Chain-of-thought ────────────────────────────────────────────────────────
  // Enable for qwen3 / deepseek-r1 models that support <think> tokens.
  "ollamaForge.enableThinking": false,

  // ── Dream cycle ─────────────────────────────────────────────────────────────
  // Model used for background memory consolidation and summarization.
  "ollamaForge.dreamModel": "",

  // ── Stack management ────────────────────────────────────────────────────────
  // SSH host for remote docker-compose stack management.
  "ollamaForge.stack.sshHost": "",
  "ollamaForge.stack.composePath": "~/docker-compose.yml",

  // ── MCP servers ─────────────────────────────────────────────────────────────
  // Alternatively, put server config in <project>/.ollamaforge/mcp.json.
  // See mcp.example.json in the extension install directory for all available servers.
  "ollamaForge.mcpServers": [],

  // ── AGENTS.md auto-refresh ──────────────────────────────────────────────────
  // Silently regenerates AGENTS.md in the background if older than N days.
  // Set to 0 to disable. Use /context slash command to refresh on demand.
  "ollamaForge.contextFile.autoUpdateDays": 7
}
